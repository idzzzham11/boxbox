<section class="card">
    <h2>Price</h2>
    <div class="stats">
        <Stat Value="@Fmt.Rm(Summary.ThisMonthSpent)" Label="This month" />
        <Stat Value="@Fmt.Rm(Summary.LastMonthSpent)" Label="Last month" />
        <Stat Value="@Fmt.Rm(Summary.AverageMonthlySpent)" Label="Avg / month" />
        <Stat Value="@Fmt.Rm(Summary.TotalSpent)" Label="@($"Total · {Summary.EntryCount} fill-ups")" />
    </div>

    @if (SpendPoints.Count > 0)
    {
        <h3>Spend per fill-up</h3>
        <LineChart Points="SpendPoints"
                   ZeroBased="true"
                   Format="@(v => "RM " + v.ToString("0"))"
                   AriaLabel="@SpendAriaLabel" />
    }

    <MonthBars Data="Summary.Months" />
</section>

@code {
    private const int MaxPoints = 30;

    [Parameter, EditorRequired] public SpendSummaryResult Summary { get; set; } = default!;

    /// <summary>The history rows (newest first, as the API returns them); the chart uses the latest 30.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<EntryDto> Entries { get; set; } = [];

    private IReadOnlyList<ChartPoint> SpendPoints =>
        Entries.OrderBy(e => e.Date).TakeLast(MaxPoints)
            .Select(e => new ChartPoint(e.Date, (double)e.AmountPaid, $"{e.Date:yyyy-MM-dd} · {Fmt.Rm(e.AmountPaid)}"))
            .ToList();

    private string SpendAriaLabel
    {
        get
        {
            var points = SpendPoints;
            return points.Count == 0
                ? "Spend per fill-up chart, no data"
                : $"Line chart of spend per fill-up over the last {points.Count} fill-ups; latest {points.OrderBy(p => p.Date).Last().Tooltip}";
        }
    }
}
