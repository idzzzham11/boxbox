@* Not a card of its own any more: it is drawn inside the Price card. *@
<h3>Spending by month</h3>
<div class="bars">
        @if (months.Count == 0)
        {
            <div class="empty">No data yet.</div>
        }
        @* @foreach renders one row per item; @key helps Blazor update rows efficiently when the list changes. *@
        @foreach (var m in months)
        {
            <div class="bar" @key="(m.Year, m.Month)">
                <span>@Names[m.Month - 1] @(m.Year % 100)</span>
                <i style="width:@Width(m)%"></i>
                <span>@Fmt.Rm(m.Total)</span>
            </div>
        }
</div>

@code {
    private static readonly string[] Names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    [Parameter, EditorRequired] public IReadOnlyList<MonthSpend> Data { get; set; } = [];

    // The last 12 months, newest first.
    private List<MonthSpend> months => Data.TakeLast(12).Reverse().ToList();

    private string Width(MonthSpend m)
    {
        var max = Math.Max(1m, months.Max(x => x.Total));
        return Math.Round(m.Total / max * 100m, 1).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    }
}
