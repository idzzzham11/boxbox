@* Data only: with too little history there is nothing to forecast, so the card is simply not shown. *@
@if (Forecast.Available)
{
    var days = Forecast.NextDate!.Value.DayNumber - Fmt.TodayMy().DayNumber;
    var when = days <= 0 ? "any day now" : days == 1 ? "tomorrow" : $"in {days} days";
    var interval = Forecast.IntervalDays!;
    var amount = Forecast.Amount!;

    <section class="card">
        @* The confidence stays visible as a few quiet words, because a forecast from a handful of fill-ups is a guess. *@
        <h2>Forecast <span class="quiet">· @Forecast.Confidence.ToLowerInvariant() confidence</span></h2>
        <div class="stats">
            <Stat Value="@Forecast.NextDate.Value.ToString("d MMM", System.Globalization.CultureInfo.InvariantCulture)"
                  Label="@($"Next fill-up · {when}")" />
            <Stat Value="@("≈ " + Fmt.RmShort(amount.Predicted))"
                  Label="@($"Amount · {Fmt.RmShort(amount.Low)} – {Fmt.RmShort(amount.High)}")" />
            @if (Forecast.Litres is { } litres)
            {
                <Stat Value="@("≈ " + Fmt.Litres(litres.Predicted))"
                      Label="@($"Litres · {Fmt.Litres(litres.Low)} – {Fmt.Litres(litres.High)}")" />
            }
            <Stat Value="@Fmt.Rm(Forecast.ProjectedMonthSpend)" Label="Projected this month" />
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public ForecastResult Forecast { get; set; } = default!;
}
